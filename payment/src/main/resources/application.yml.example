spring:
  application:
    name: payment
  datasource:
    url: jdbc:mysql://localhost:3306/shop?serverTimezone=UTC&characterEncoding=UTF-8
    username: nova
    password: CHANGE_ME
    hikari:
      # MySQL 서버 기본값은 REPEATABLE READ 다. 반드시 여기서 바꾼다.
      # 근거: "없는 행을 잠금 읽기로 확인한 뒤 INSERT" 하는 절차가 RR 에서
      #      갭 락과 삽입 의도 락으로 교착한다 (실측 RR 4/4 데드락, RC 4/4 통과).
      # 빠뜨려도 오류가 나지 않는다. 부하가 걸릴 때까지 아무도 모른다.
      transaction-isolation: TRANSACTION_READ_COMMITTED
      maximum-pool-size: 10
  jpa:
    # 정본은 flyway-project/migrations. docs/schema.sql은 생성된 최신 구조다.
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        jdbc:
          time_zone: UTC
    open-in-view: false
  task:
    scheduling:
      # 주기 작업(승인 복구 · 환불 · 결제창 만료, config.PaymentJobs) 실행기. 셋이 서로 밀리지 않게 3(빠뜨려도 코드가 3 이상으로 둔다).
      # 종료 때 진행 중인 복구 한 건(토스 호출 최대 63초)을 기다린다 — 끊겨도 리스가 끝나면 다른 인스턴스가 같은 키로 이어 받는다
      pool:
        size: 3
      shutdown:
        await-termination: true
        await-termination-period: 75s
  data:
    redis:
      # 폐기 표식(로그아웃 · 제재) 조회. member 와 같은 Redis. 응답이 늦으면 모든 인증 요청이 늦어지므로 짧게 끊는다
      host: localhost
      port: 6379
      timeout: 300ms
      connect-timeout: 200ms
  http:
    serviceclient:
      # 토스페이먼츠 결제 승인 · 취소 · 조회. 읽기 60초는 토스 권장값, 연결 3초는 SYN 재전송 1회 여유(D9).
      # 호출 한 번의 최대 시간 = 연결 3 + 읽기 60 ≤ 리스 70(D12). 읽기는 본문을 다 받을 때까지의 총 기한이다.
      # HTTP 구현은 JDK 로 고정(HttpClientConfig) — 풀 대기가 없고, spring.http.clients.imperative.factory 는 무시된다.
      # 아래 값이 없거나 합이 리스를 넘거나 리다이렉트를 따라가면 기동하지 않는다(TossHttpSettingsVerifier).
      # 타임아웃은 실패가 아니라 결과 불명이다. 샌드박스 · 운영 주소가 같고 키(test_sk_ · live_sk_)로 갈린다
      toss:
        base-url: https://api.tosspayments.com
        connect-timeout: 3s
        read-timeout: 60s
        # POST 가 301/302 로 GET 이 되거나 다른 곳으로 가지 않게
        redirects: dont-follow

logging:
  level:
    # DEBUG 에서 RestClient 가 요청 URL 을 찍는다 — 취소 · 조회 URL 에는 토스 결제 키가 들어 있다. 운영에서 낮추지 않는다
    org.springframework.web.client: INFO

nova:
  payment:
    toss:
      # 필수(없으면 기동 실패). 환경 변수 · 비밀 저장소로만 준다 — 이 파일 · 저장소에 값을 적지 않는다
      secret-key: ${TOSS_SECRET_KEY}
    # 주기 작업. 끄면(jobs.enabled: false) 결과 불명 거래 · 환불 · 시작 안 된 결제창이 영영 남는다 — 운영에서 끄지 않는다
    jobs:
      enabled: true
    recovery:
      interval: 5s     # 승인 복구 실행 간격(앞 실행이 끝난 뒤부터)
    refund:
      interval: 5s     # 환불 실행 · 복구 간격. 승인 복구와 따로 돈다
    expiry:
      interval: 60s    # 결제창 만료 실행 간격. 만료 기준(35분)은 코드 상수다
  # SQS(AWS SDK v2). 결제 · 환불 결과 이벤트를 대상 서비스 큐(order-events)로 보내고, 환불 요청을 payment-events 에서 받는다.
  # 로컬은 Floci(docker/floci), 배포 환경은 endpoint 를 지우고 IAM 역할을 쓴다
  sqs:
    region: ap-northeast-2
    endpoint: http://localhost:4566
    api-call-timeout: 3s
    # 논리 목적지 → 실제 큐 이름(환경마다 접두어를 붙일 때만)
    # queues:
    #   order-events: dev-order-events
    #   payment-events: dev-payment-events
    # 환불 요청 소비기. 끄면 환불 요청이 큐에 쌓이기만 한다 — 운영에서 끄지 않는다
    consumer:
      enabled: true
      queue: payment-events
      concurrency: 1
      wait-seconds: 20
      visibility: 5m       # 처리 한 건보다 길게
      backoff-base: 30s    # 실패는 대개 DB 장애 — 재수신 5회(DLQ 전)가 장애 조치보다 길게(약 7분)
      backoff-max: 5m
  # 아웃박스 발행(payment_outbox_events). transport 는 필수(없으면 기동 실패)이고 운영 값은 sqs 다.
  # log 는 로컬 · 테스트 전용 전송이라 log-transport-allowed: true 를 함께 적어야 뜬다 — 그 줄은 이 예시에 적지 않는다
  outbox:
    transport: sqs
    concurrency: 32        # 커밋 직후 발행 동시 실행 상한(가상 스레드). 넘치면 릴레이가 보낸다
    relay-interval: 10s    # 릴레이 주기(전용 스레드에서 돈다 — @EnableScheduling 이 필요 없다)
    relay-after: 1m        # 만든 지 이만큼 지난 미발행 행만 재발행
    relay-batch: 100
    relay-lease: 1m        # 전송 한 번(sqs.api-call-timeout 의 두 배)보다 길어야 한다(아니면 기동 실패)

# 내부 전용. 사용자 트래픽은 order(8084) · draw 를 거쳐 들어온다.
server:
  port: 8085

auth:
  # 폐기 표식 조회가 실패(Redis 장애)했을 때 401 로 닫는 경로. 목록 밖은 열린다(통과 + 경고 + 카운터).
  # 목록을 주면 공통 기본값을 **대체**한다 — 그래서 공통 기본 셋(관리자 · 재발급 · 내 정보)도 다시 적는다.
  # 내부 API 는 닫는다: 결제 흐름은 호출자(order)가 이미 닫으므로 잃는 것이 없고, 호출자가 닫기를 빠뜨려도 여기서 막는다.
  revocation-check:
    fail-closed-paths:
      - /api/v1/admin/**
      - /api/v1/session/refresh
      - /api/v1/me/**
      - /internal/**

# 검증만 한다(개인키 없음). 공개키는 member 가 게시하는 JWKS(GET /.well-known/jwks.json)에서 받아 kid 로 고른다 —
# 기동 직후와 5분마다 백그라운드로 받고, 요청 스레드는 캐시만 읽는다. 키를 바꿀 때 이 서비스는 재배포하지 않는다.
# issuer·audience 는 member 와 같은 값이어야 검증이 통과한다.
jwt:
  issuer: nova
  audience: nova-api
  jwk-set-uri: https://member.example.com/.well-known/jwks.json
  # jwk-set-allow-http: true    # VPC 안 Cloud Map 주소(http://member.ureca.local:8080/…)를 쓰는 동안만 명시. 서비스 간 TLS 가 붙으면 지운다
