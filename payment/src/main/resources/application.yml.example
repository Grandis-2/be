spring:
  application:
    name: payment
  datasource:
    url: jdbc:mysql://localhost:3306/shop?serverTimezone=UTC&characterEncoding=UTF-8
    username: nova
    password: CHANGE_ME
    hikari:
      # MySQL 서버 기본값은 REPEATABLE READ 다. 반드시 여기서 바꾼다.
      # 근거: "없는 행을 잠금 읽기로 확인한 뒤 INSERT" 하는 절차가 RR 에서
      #      갭 락과 삽입 의도 락으로 교착한다 (실측 RR 4/4 데드락, RC 4/4 통과).
      # 빠뜨려도 오류가 나지 않는다. 부하가 걸릴 때까지 아무도 모른다.
      transaction-isolation: TRANSACTION_READ_COMMITTED
      maximum-pool-size: 10
  jpa:
    # 정본은 flyway-project/migrations. docs/schema.sql은 생성된 최신 구조다.
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        jdbc:
          time_zone: UTC
    open-in-view: false
  data:
    redis:
      # 폐기 표식(로그아웃 · 제재) 조회. member 와 같은 Redis. 응답이 늦으면 모든 인증 요청이 늦어지므로 짧게 끊는다
      host: localhost
      port: 6379
      timeout: 300ms
      connect-timeout: 200ms
  http:
    serviceclient:
      # 토스페이먼츠 결제 승인 · 취소 · 조회. 읽기 60초는 토스 권장값, 연결 3초는 SYN 재전송 1회 여유(D9).
      # 호출 한 번의 최대 시간 = 연결 3 + 읽기 60 ≤ 리스 70(D12). 읽기는 본문을 다 받을 때까지의 총 기한이다.
      # HTTP 구현은 JDK 로 고정(HttpClientConfig) — 풀 대기가 없고, spring.http.clients.imperative.factory 는 무시된다.
      # 아래 값이 없거나 합이 리스를 넘거나 리다이렉트를 따라가면 기동하지 않는다(TossHttpSettingsVerifier).
      # 타임아웃은 실패가 아니라 결과 불명이다. 샌드박스 · 운영 주소가 같고 키(test_sk_ · live_sk_)로 갈린다
      toss:
        base-url: https://api.tosspayments.com
        connect-timeout: 3s
        read-timeout: 60s
        # POST 가 301/302 로 GET 이 되거나 다른 곳으로 가지 않게
        redirects: dont-follow

logging:
  level:
    # DEBUG 에서 RestClient 가 요청 URL 을 찍는다 — 취소 · 조회 URL 에는 토스 결제 키가 들어 있다. 운영에서 낮추지 않는다
    org.springframework.web.client: INFO

nova:
  payment:
    toss:
      # 필수(없으면 기동 실패). 환경 변수 · 비밀 저장소로만 준다 — 이 파일 · 저장소에 값을 적지 않는다
      secret-key: ${TOSS_SECRET_KEY}

# 내부 전용. 사용자 트래픽은 order(8084) · draw 를 거쳐 들어온다.
server:
  port: 8085

auth:
  # 폐기 표식 조회가 실패(Redis 장애)했을 때 401 로 닫는 경로. 목록 밖은 열린다(통과 + 경고 + 카운터).
  # 목록을 주면 공통 기본값을 **대체**한다 — 그래서 공통 기본 셋(관리자 · 재발급 · 내 정보)도 다시 적는다.
  # 내부 API 는 닫는다: 결제 흐름은 호출자(order)가 이미 닫으므로 잃는 것이 없고, 호출자가 닫기를 빠뜨려도 여기서 막는다.
  revocation-check:
    fail-closed-paths:
      - /api/v1/admin/**
      - /api/v1/session/refresh
      - /api/v1/me/**
      - /internal/**

# 검증만 한다(개인키 없음). 공개키는 member 가 게시하는 JWKS(GET /.well-known/jwks.json)에서 받아 kid 로 고른다 —
# 기동 직후와 5분마다 백그라운드로 받고, 요청 스레드는 캐시만 읽는다. 키를 바꿀 때 이 서비스는 재배포하지 않는다.
# issuer·audience 는 member 와 같은 값이어야 검증이 통과한다.
jwt:
  issuer: nova
  audience: nova-api
  jwk-set-uri: https://member.example.com/.well-known/jwks.json
  # 필수(없으면 기동 실패 — JwtProperties @NotNull). 검증만 하는 서비스에서는 쓰이지 않지만 member 와 같은 값을 둔다
  access-token-validity: 30m
  refresh-token-validity: 14d
  # jwk-set-allow-http: true    # VPC 안 Cloud Map 주소(http://member.ureca.local:8080/…)를 쓰는 동안만 명시. 서비스 간 TLS 가 붙으면 지운다
