spring:
  application:
    name: order
  datasource:
    url: jdbc:mysql://localhost:3306/shop?serverTimezone=UTC&characterEncoding=UTF-8
    username: nova
    password: CHANGE_ME
    hikari:
      # MySQL 서버 기본값은 REPEATABLE READ 다. 반드시 여기서 바꾼다.
      # 근거: "없는 행을 잠금 읽기로 확인한 뒤 INSERT" 하는 절차가 RR 에서
      #      갭 락과 삽입 의도 락으로 교착한다 (실측 RR 4/4 데드락, RC 4/4 통과).
      # 빠뜨려도 오류가 나지 않는다. 부하가 걸릴 때까지 아무도 모른다.
      transaction-isolation: TRANSACTION_READ_COMMITTED
      maximum-pool-size: 10
  jpa:
    # 정본은 flyway-project/migrations. docs/schema.sql은 생성된 최신 구조다.
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        jdbc:
          time_zone: UTC
    open-in-view: false
  data:
    redis:
      # 폐기 표식(로그아웃 · 제재) 조회. member 와 같은 Redis. 응답이 늦으면 모든 인증 요청이 늦어지므로 짧게 끊는다
      host: localhost
      port: 6379
      timeout: 300ms
      connect-timeout: 200ms
  http:
    serviceclient:
      # 주문 생성 때 예약 조회(GET /internal/preorders/{token}). 답이 없으면 주문을 만들지 않고 503 이다.
      preorder:
        base-url: http://localhost:8083
        connect-timeout: 300ms
        read-timeout: 1s
      # 결제 준비 때 결제창을 열 거래 생성(POST /internal/payment-attempts). 토스를 부르지 않는 짧은 호출이라 preorder 와 같은 수준이다.
      # 답이 없으면 503 이고, payment 가 이미 만든 거래는 버려진 PENDING 으로 남는다(사용자가 다시 부른다)
      payment:
        base-url: http://localhost:8085
        connect-timeout: 300ms
        read-timeout: 1s

server:
  port: 8084

# OpenAPI 문서. 기본은 꺼져 있고 값이 정확히 true 일 때만 켜진다(빈 값 · no · 오타는 꺼짐). 운영에는 적지 않는다.
# api-docs 가 주 스위치다 — UI 만 꺼도 스펙은 열린다. /internal/** 은 nova.openapi.include-internal: true 일 때만 실린다.
# springdoc:
#   api-docs:
#     enabled: true
#   swagger-ui:
#     enabled: true

nova:
  # SQS(AWS SDK v2). 로컬은 Floci(docker/floci). 배포 환경은 endpoint 를 지우고 IAM 역할을 쓴다
  sqs:
    region: ap-northeast-2
    endpoint: http://localhost:4566
    api-call-timeout: 3s
    # 논리 목적지 → 실제 큐 이름(환경마다 접두어를 붙일 때만)
    # queues:
    #   preorder-events: dev-preorder-events
    consumer:
      enabled: true
      queue: order-events
      concurrency: 1
      wait-seconds: 20
      visibility: 5m       # 처리 한 건보다 길게
      backoff-base: 5s
      backoff-max: 5m
  # 아웃박스 발행. transport 는 필수(없으면 기동 실패)이고 운영 값은 sqs 다.
  # log 는 보내지 않고 행을 발행 완료로 표시하는 로컬 · 테스트 전용 전송이라, log-transport-allowed: true 를 함께 적어야 뜬다.
  # 그 허용 줄은 이 예시에 적지 않는다 — 여기서 만든 운영 설정이 실수로 log 로 뜨지 않게
  outbox:
    transport: sqs
    concurrency: 32        # 커밋 직후 발행 동시 실행 상한(가상 스레드). 넘치면 릴레이가 보낸다
    relay-interval: 10s    # 릴레이 주기
    relay-after: 1m        # 만든 지 이만큼 지난 미발행 행만 재발행
    relay-batch: 100

auth:
  # 폐기 표식 조회가 실패(Redis 장애)했을 때 401 로 닫는 경로. 목록 밖은 열린다(통과 + 경고 + 카운터).
  # 목록을 주면 공통 기본값을 **대체**한다 — 그래서 공통 기본 셋(관리자 · 재발급 · 내 정보)도 다시 적는다.
  # 도메인 경로는 order 가 서비스하는 것: 결제 · 주문 취소 · 배송지 변경(엔드포인트는 예정, 미리 닫아 둔다).
  # 항목 앞에 HTTP 메서드를 붙이면 그 메서드만 닫는다. 모양이 틀린 항목은 기동 실패다.
  revocation-check:
    fail-closed-paths:
      - /api/v1/admin/**
      - /api/v1/session/refresh
      - /api/v1/me/**
      - /api/v1/orders/*/payment-attempts/**
      - POST /api/v1/orders/*/cancel
      - PATCH /api/v1/orders/*/shipping-address
      # 주문 생성은 열어 둔다(2026-09-29 결정): 닫으면 Redis 장애 동안 전원 주문 불가. 결제 · 취소 · 배송지가 닫혀 있어
      # 폐기 세션이 만든 미결제 주문으로 할 수 있는 일이 없다. 주문 생성에 재고 선점 같은 부수효과가 붙으면 아래를 켠다
      # - POST /api/v1/orders

# 검증만 한다(개인키 없음). 공개키는 member 가 게시하는 JWKS(GET /.well-known/jwks.json)에서 받아 kid 로 고른다 —
# 기동 직후와 5분마다 백그라운드로 받고, 요청 스레드는 캐시만 읽는다. 키를 바꿀 때 이 서비스는 재배포하지 않는다.
# issuer·audience 는 member 와 같은 값이어야 검증이 통과한다.
jwt:
  issuer: nova
  audience: nova-api
  jwk-set-uri: https://member.example.com/.well-known/jwks.json
  # 필수(없으면 기동 실패 — JwtProperties @NotNull). 검증만 하는 서비스에서는 쓰이지 않지만 member 와 같은 값을 둔다
  access-token-validity: 30m
  refresh-token-validity: 14d
  # jwk-set-allow-http: true    # VPC 안 Cloud Map 주소(http://member.ureca.local:8080/…)를 쓰는 동안만 명시. 서비스 간 TLS 가 붙으면 지운다
