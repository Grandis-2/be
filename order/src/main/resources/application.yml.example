spring:
  application:
    name: order
  datasource:
    url: jdbc:mysql://localhost:3306/shop?serverTimezone=UTC&characterEncoding=UTF-8
    username: nova
    password: CHANGE_ME
    hikari:
      # MySQL 서버 기본값은 REPEATABLE READ 다. 반드시 여기서 바꾼다.
      # 근거: "없는 행을 잠금 읽기로 확인한 뒤 INSERT" 하는 절차가 RR 에서
      #      갭 락과 삽입 의도 락으로 교착한다 (실측 RR 4/4 데드락, RC 4/4 통과).
      # 빠뜨려도 오류가 나지 않는다. 부하가 걸릴 때까지 아무도 모른다.
      transaction-isolation: TRANSACTION_READ_COMMITTED
      maximum-pool-size: 10
  jpa:
    # 정본은 flyway-project/migrations. docs/schema.sql은 생성된 최신 구조다.
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        jdbc:
          time_zone: UTC
    open-in-view: false
  http:
    serviceclient:
      # 주문 생성 때 예약 조회(GET /internal/preorders/{token}). 답이 없으면 주문을 만들지 않고 503 이다.
      preorder:
        base-url: http://localhost:8083
        connect-timeout: 300ms
        read-timeout: 1s

server:
  port: 8084

nova:
  # SQS(AWS SDK v2). 로컬은 Floci(docker/floci). 배포 환경은 endpoint 를 지우고 IAM 역할을 쓴다
  sqs:
    region: ap-northeast-2
    endpoint: http://localhost:4566
    api-call-timeout: 3s
    # 논리 목적지 → 실제 큐 이름(환경마다 접두어를 붙일 때만)
    # queues:
    #   preorder-events: dev-preorder-events
    consumer:
      enabled: true
      queue: order-events
      concurrency: 1
      wait-seconds: 20
      visibility: 5m       # 처리 한 건보다 길게
      backoff-base: 5s
      backoff-max: 5m

# 검증만 한다. 공개키 하나면 되고 member 를 호출하지 않는다.
jwt:
  public-key: file:${JWT_PUBLIC_KEY_PATH:./keys/jwt-public.pem}
