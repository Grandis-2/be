spring:
  application:
    name: preorder
  # 요청 처리 · 스케줄러를 가상 스레드로. DB 동시성은 커넥션 풀(maximum-pool-size)이 막는다
  threads:
    virtual:
      enabled: true
  datasource:
    url: jdbc:mysql://localhost:3306/shop?serverTimezone=UTC&characterEncoding=UTF-8
    username: nova
    password: CHANGE_ME
    hikari:
      # MySQL 서버 기본값은 REPEATABLE READ 다. 반드시 여기서 바꾼다.
      # 근거: "없는 행을 잠금 읽기로 확인한 뒤 INSERT" 하는 절차가 RR 에서
      #      갭 락과 삽입 의도 락으로 교착한다 (실측 RR 4/4 데드락, RC 4/4 통과).
      # 빠뜨려도 오류가 나지 않는다. 부하가 걸릴 때까지 아무도 모른다.
      transaction-isolation: TRANSACTION_READ_COMMITTED
      maximum-pool-size: 10
      # 가상 스레드라 요청이 풀 앞에서 기다린다. 기본 30s 대신 빨리 실패시킨다(ms)
      connection-timeout: 2000
  jpa:
    # 정본은 flyway-project/migrations. docs/schema.sql은 생성된 최신 구조다.
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        jdbc:
          time_zone: UTC
    open-in-view: false
  http:
    serviceclient:
      # 캐시가 비었을 때만 부른다(CatalogReader). 타임아웃: 연결 300ms · 읽기 1s.
      catalog:
        base-url: http://localhost:8082
        connect-timeout: 300ms
        read-timeout: 1s
      # 취소 사전 확인. 답이 없으면 취소를 시작하지 않고 503 이다.
      order:
        base-url: http://localhost:8084
        connect-timeout: 300ms
        read-timeout: 1s
  data:
    redis:
      host: localhost
      port: 6379
      # 죽는 것보다 느려지는 게 위험하다 — 응답이 5초씩 걸리면 톰캣 스레드가 전부 잠기고
      # Redis 와 무관한 API 까지 멈춘다. 300ms 를 넘겼으면 캐시를 쓸 이유가 없다.
      timeout: 300ms
      connect-timeout: 200ms
      lettuce:
        pool:
          max-active: 16
          max-wait: 100ms

server:
  port: 8083

# 관측. 관리 엔드포인트는 앱과 다른 포트로 분리한다 — ALB 대상 그룹은 앱 포트만, 수집기만 관리 포트에 접근한다.
# 부하 시험의 p99 를 보려고 요청 지연은 히스토그램으로 낸다
management:
  server:
    port: 9083
  endpoints:
    web:
      exposure:
        include: health, prometheus
  endpoint:
    health:
      # 헬스 체크는 /actuator/health/readiness 로 한다. 전체(/actuator/health)는 Redis · DB 상태를 포함해
      # Redis 장애만으로 모든 인스턴스가 빠진다(폐기 확인은 Redis 장애에도 접수를 통과시키는 정책)
      probes:
        enabled: true
  metrics:
    distribution:
      percentiles-histogram:
        http.server.requests: true
        preorder.accept: true
        preorder.events.handle: true
        preorder.events.lag: true

nova:
  # 대기열 입장권. 게이트웨이와 같은 비밀(Secrets Manager). 형식: gateway-auth-tokens.md 5절
  admission-ticket:
    secret: ${WAITING_TOKEN_SECRET}
    previous: ${WAITING_TOKEN_PREVIOUS:}
    rollout-ends-at: ${WAITING_TOKEN_ROLLOUT_ENDS_AT:}
  # SQS(AWS SDK v2). 로컬은 Floci(docker/floci). 배포 환경은 endpoint 를 지우고 IAM 역할을 쓴다
  sqs:
    region: ap-northeast-2
    endpoint: http://localhost:4566
    api-call-timeout: 3s
    # 논리 목적지 → 실제 큐 이름(환경마다 접두어를 붙일 때만)
    # queues:
    #   preorder-register: dev-preorder-register
    consumer:
      enabled: true
      queue: preorder-events
      concurrency: 1
      wait-seconds: 20
      visibility: 5m       # 처리 한 건(회차 취소 포함)보다 길게
      backoff-base: 5s
      backoff-max: 5m
  # 아웃박스 발행. transport 는 필수(없으면 기동 실패): sqs, 또는 보내지 않고 로그로만 남기는 log
  outbox:
    transport: sqs
    concurrency: 32        # 커밋 직후 발행 동시 실행 상한(가상 스레드). 넘치면 릴레이가 보낸다
    relay-interval: 10s    # 릴레이 주기
    relay-after: 1m        # 만든 지 이만큼 지난 미발행 행만 재발행
    relay-batch: 100
  # DB 에서 세는 상태 지표(예약 상태별 수 · 미발행 아웃박스) 갱신 주기
  metrics:
    refresh-interval: 30s
  # 외부 예약 Mock 등록 요청의 scope(시험 실행 범위). 접수 때 request_payload 에 고정된다
  external-mock:
    scope: preorder

# 내부 호출(catalog · order) 장애 대응. 기본값은 코드(PreorderDefaults)에 있고, 바꿀 때만 여기서 덮는다
# resilience4j:
#   circuitbreaker:
#     instances:
#       order:
#         wait-duration-in-open-state: 30s
#   bulkhead:
#     configs:
#       default:
#         max-concurrent-calls: 40

# 외부 예약 Mock (별도 레포)
external:
  mock:
    base-url: http://localhost:8081

# 검증만 한다(개인키 없음). 공개키는 member 가 게시하는 JWKS(GET /.well-known/jwks.json)에서 받아 kid 로 고른다 —
# 기동 직후와 5분마다 백그라운드로 받고, 요청 스레드는 캐시만 읽는다. 키를 바꿀 때 이 서비스는 재배포하지 않는다.
# issuer·audience 는 member 와 같은 값이어야 검증이 통과한다.
jwt:
  issuer: nova
  audience: nova-api
  jwk-set-uri: https://member.example.com/.well-known/jwks.json
  # jwk-set-allow-http: true    # VPC 안 Cloud Map 주소(http://member.ureca.local:8080/…)를 쓰는 동안만 명시. 서비스 간 TLS 가 붙으면 지운다
  # 발급하지 않지만 필수 값이다(없으면 기동 실패). member 와 같게 둔다
  access-token-validity: 30m
  refresh-token-validity: 14d

# 토큰 폐기 확인(Redis)이 실패할 때 막는 경로. 기본값(관리자 · 예약 취소)은 jar 의 preorder-defaults.properties 에 있다.
# 바꿀 때만 여기서 덮는다
# auth:
#   revocation-check:
#     fail-closed-paths:
#       - /api/v1/admin/**
#       - /api/v1/preorders/*/cancel
