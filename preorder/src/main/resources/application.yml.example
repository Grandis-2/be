spring:
  application:
    name: preorder
  # 요청 처리 · 스케줄러를 가상 스레드로. DB 동시성은 커넥션 풀(maximum-pool-size)이 막는다
  threads:
    virtual:
      enabled: true
  datasource:
    url: jdbc:mysql://localhost:3306/shop?serverTimezone=UTC&characterEncoding=UTF-8
    username: nova
    password: CHANGE_ME
    hikari:
      # MySQL 서버 기본값은 REPEATABLE READ 다. 반드시 여기서 바꾼다.
      # 근거: "없는 행을 잠금 읽기로 확인한 뒤 INSERT" 하는 절차가 RR 에서
      #      갭 락과 삽입 의도 락으로 교착한다 (실측 RR 4/4 데드락, RC 4/4 통과).
      # 빠뜨려도 오류가 나지 않는다. 부하가 걸릴 때까지 아무도 모른다.
      transaction-isolation: TRANSACTION_READ_COMMITTED
      maximum-pool-size: 10
      # 가상 스레드라 요청이 풀 앞에서 기다린다. 기본 30s 대신 빨리 실패시킨다(ms)
      connection-timeout: 2000
      # DB 왕복을 줄이는 드라이버 옵션(data-source-properties)은 코드 기본값(PreorderDefaults)에 있다. 바꿀 때만 여기서 덮는다
  jpa:
    # 정본은 flyway-project/migrations. 최신 구조 덤프는 bash flyway-project/verify.sh 의 build/flyway/schema.sql.
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        jdbc:
          time_zone: UTC
    open-in-view: false
  http:
    serviceclient:
      # 캐시가 비었을 때만 부른다(CatalogReader). 타임아웃: 연결 300ms · 읽기 1s.
      catalog:
        base-url: http://localhost:8082
        connect-timeout: 300ms
        read-timeout: 1s
      # 취소 사전 확인. 답이 없으면 취소를 시작하지 않고 503 이다.
      order:
        base-url: http://localhost:8084
        connect-timeout: 300ms
        read-timeout: 1s
      # 관리자 예약 목록 · 상세의 회원 이름(GET /internal/customers/names) — contracts/member-internal.md. 타임아웃은 코드 기본값
      # (연결 300ms · 읽기 500ms, PreorderDefaults). 주소가 없거나 답이 없으면 이름(customerName)만 비우고 목록은 그대로 준다
      member:
        base-url: http://localhost:8080
  data:
    redis:
      host: localhost
      port: 6379
      # 죽는 것보다 느려지는 게 위험하다 — 응답이 5초씩 걸리면 톰캣 스레드가 전부 잠기고
      # Redis 와 무관한 API 까지 멈춘다. 300ms 를 넘겼으면 캐시를 쓸 이유가 없다.
      timeout: 300ms
      connect-timeout: 200ms
      lettuce:
        pool:
          max-active: 16
          max-wait: 100ms

server:
  port: 8083

# OpenAPI 문서. 기본은 꺼져 있고 값이 정확히 true 일 때만 켜진다(빈 값 · no · 오타는 꺼짐). 운영에는 적지 않는다.
# 문서는 /v3/api-docs/preorder, /internal/** 은 nova.openapi.include-internal: true 일 때만 실린다.
# springdoc:
#   api-docs:
#     enabled: true
#   swagger-ui:
#     enabled: true

# 관측(관리 포트 9083 · health · prometheus · readiness · 지연 히스토그램)은 코드 기본값(PreorderDefaults)에 있다.
# 관리 포트를 서비스 포트와 같게 두거나 끄면 기동이 막힌다 — 헬스 체크는 관리 포트의 /actuator/health/readiness 로 한다

nova:
  # 정합성 검사 관리자 API(/api/v1/admin/preorders/reconciliation). 회차 오픈 후 이 시간 안에는 실행 요청을 409 로 막는다.
  # batch-reconciliation 의 nova.batch.reconciliation.intake-rush-window 와 같게 둔다. 기본값 1h
  # 일괄 키로 Mock 취소의 마감 시간 — 넘으면 남은 건은 시작하지 않고 건별 결과로 돌려준다(로드밸런서 제한 시간보다 짧게). 기본값 20s
  # reconciliation:
  #   intake-rush-window: 1h
  #   external-cancel-batch-deadline: 20s
  # 대기열 입장권. 게이트웨이와 같은 비밀(Secrets Manager). 형식: gateway-auth-tokens.md 5절
  admission-ticket:
    secret: ${WAITING_TOKEN_SECRET}
    previous: ${WAITING_TOKEN_PREVIOUS:}
    rollout-ends-at: ${WAITING_TOKEN_ROLLOUT_ENDS_AT:}
  # SQS(AWS SDK v2). 로컬은 Floci(docker/floci). 배포 환경은 endpoint 를 지우고 IAM 역할을 쓴다
  sqs:
    region: ap-northeast-2
    endpoint: http://localhost:4566
    api-call-timeout: 3s
    # 논리 목적지 → 실제 큐 이름(환경마다 접두어를 붙일 때만)
    # queues:
    #   preorder-register: dev-preorder-register
    consumer:
      enabled: true
      queue: preorder-events
      concurrency: 1
      wait-seconds: 20
      visibility: 5m       # 처리 한 건(회차 취소 포함)보다 길게
      backoff-base: 30s
      backoff-max: 5m
      # 앞선 이벤트를 기다리는 메시지(회차보다 먼저 온 공개 여부 변경)는 같은 큐로 늦춰 다시 보낸다. 기본값은 코드에 있다:
      # defer-first-delay: 10s(보류할 때마다 두 배) · defer-max-delay: 15m(SQS 상한) · defer-alert-after: 1h(ERROR 한 번)
    # 소비 큐의 DLQ 를 DB(preorder_dead_letter_events)로 옮긴다. 관리자 API(/api/v1/admin/preorders/dead-letters)로 조회 · 되돌리기 · 버리기
    # 켜기는 코드 기본값(PreorderDefaults)이 받기 소비기(consumer.enabled)를 따른다. 끄려면 enabled: false
    dead-letter:
      queue: preorder-events-dlq
  # 접수 격벽 — 같은 상품의 접수를 커넥션 밖에서 줄 세운다. 기본값은 코드(AcceptBulkheadProperties)에 있다:
  # accept.bulkhead: product-permits 4 · pool-share 0.5(풀 10 → 전체 5) · instance-limit 0(풀에서 계산)
  #                  · max-wait 3s · retry-after-min 1s · retry-after-max 3s(넘치면 503 + 그 사이 Retry-After)
  # 태스크 용량 하트비트(공유 Redis, contracts/preorder-capacity-heartbeat.md). 기본값은 코드(CapacityHeartbeatProperties)에 있다:
  # capacity.heartbeat: enabled true · interval 5s · stale-after 15s · accept-per-second 100(운영 실측으로 바꾼다)
  # 아웃박스 발행(common:outbox). transport 는 필수(없으면 기동 실패)다. 배포 환경은 sqs 다(log 는 로컬 · 시험 전용)
  # 지표 이름 접두어(metrics-prefix: preorder.outbox)는 코드(PreorderDefaults)에 기본값이 있다
  outbox:
    transport: sqs
    # 커밋 직후 발행 스레드 수(= 발행이 쥐는 커넥션 상한)는 코드 기본값 2(PreorderDefaults) — 덮지 않는다. 32 로 두면 풀을 접수와 다툰다
    # buffer: 1000         # 발행을 기다리는 행 상한. 넘치면 릴레이가 보낸다
    relay-interval: 10s    # 릴레이 주기. 미발행 현황 지표(preorder.outbox.unpublished*)도 이 주기로 센다
    relay-after: 1m        # 만든 지 이만큼 지난 미발행 행만 재발행
    relay-batch: 100
    # 가져간 행을 다른 인스턴스가 건너뛰는 시간. 행마다 보내기 직전에 연장한다.
    # 전송 한 번은 sqs.api-call-timeout × 2(큐 URL 조회 + 전송)이고, 리스는 그것 + 5s 보다 길어야 한다(아니면 기동 실패)
    relay-lease: 1m
  # DB 에서 세는 상태 지표(예약 상태별 수 · DLQ) 갱신 주기
  metrics:
    refresh-interval: 30s
  # 오픈 알림(회차가 열리면 신청자에게 회원 알림)을 찾는 주기 작업. 기본값은 코드에 있다:
  # campaign.open-alert.interval: 30s · window: 1h(연 지 이보다 오래된 회차는 보내지 않는다) · batch-size: 100
  # 회차 캐시(일정 · 공개 · 차수, 인스턴스 안). 바뀌면 커밋 뒤 모든 인스턴스에서 비우고 수명은 놓쳤을 때의 상한이다. 기본값은 코드에 있다:
  # campaign.cache.ttl: 30s · max-products: 1000 · missing-ttl: 5s(회차 없음) · missing-max-products: 10000
  # 회차 일정에 맞춘 대기열 · preorder 최소 대수(contracts/preorder-capacity-scaling.md). 기본은 꺼짐(계산만 해 로그). 켤 때:
  # scaling.enabled: true · cluster: nova-prod · waitingroom.service: nova-prod-waitingroom · preorder.service: nova-prod-preorder
  # · waitingroom.max · preorder.max 는 Terraform 의 max 와 같게
  # 외부 예약 Mock 등록 요청의 scope(시험 실행 범위). 접수 때 request_payload 에 고정된다
  external-mock:
    scope: preorder
  # 브라우저 호출을 허용할 프론트 오리진(scheme://host[:port], 정확 일치). 적으면 기본값(운영 프론트 두 도메인 · API 도메인)이 통째로 바뀐다.
  # 로컬에서만 적는다 — 운영은 기본값을 쓴다.
  cors:
    allowed-origins:
      - http://localhost:5173   # 로컬 프론트(Vite)
      - http://localhost:9000   # 로컬 문서 허브(docker/openapi-hub)

# 내부 호출(catalog · order) 장애 대응. 기본값은 코드(PreorderDefaults)에 있고, 바꿀 때만 여기서 덮는다
# resilience4j:
#   circuitbreaker:
#     instances:
#       order:
#         wait-duration-in-open-state: 30s
#   bulkhead:
#     configs:
#       default:
#         max-concurrent-calls: 40

# 외부 예약 Mock (별도 레포). 정합성 조치의 키로 Mock 취소가 키로 조회 · 취소를 부른다 — 관리자가 결과를 기다리는 호출이라
# 제한 시간이 짧다(기본 연결 300ms · 읽기 2s). 주소 속성 이름은 batch-reconciliation 과 같다. 없으면 기동하지 않는다.
# 서킷 브레이커 · 동시 호출 상한은 내부 호출과 같은 기본값을 이름 mock 으로 쓴다(resilience4j.*.instances.mock 으로 덮는다)
external:
  mock:
    base-url: http://localhost:8081
    # connect-timeout: 300ms
    # read-timeout: 2s

# 검증만 한다(개인키 없음). 공개키는 member 가 게시하는 JWKS(GET /.well-known/jwks.json)에서 받아 kid 로 고른다 —
# 기동 직후와 5분마다 백그라운드로 받고, 요청 스레드는 캐시만 읽는다. 키를 바꿀 때 이 서비스는 재배포하지 않는다.
# issuer·audience 는 member 와 같은 값이어야 검증이 통과한다.
jwt:
  issuer: nova
  audience: nova-api
  jwk-set-uri: https://member.example.com/.well-known/jwks.json
  # jwk-set-allow-http: true    # VPC 안 Cloud Map 주소(http://member.ureca.local:8080/…)를 쓰는 동안만 명시. 서비스 간 TLS 가 붙으면 지운다

# 토큰 폐기 확인(Redis)이 실패할 때 막는 경로. 기본값(관리자 · 예약 취소)은 코드(PreorderDefaults)에 있다.
# 바꿀 때만 여기서 덮는다
# auth:
#   revocation-check:
#     fail-closed-paths:
#       - /api/v1/admin/**
#       - /api/v1/preorders/*/cancel
