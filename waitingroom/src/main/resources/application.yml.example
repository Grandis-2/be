server:
  port: 8085

# issuer · audience 는 member 와 같은 값이어야 검증이 통과한다.
jwt:
  issuer: nova
  audience: nova-api
  jwk-set-uri: https://member.example.com/.well-known/jwks.json
  # jwk-set-allow-http: true    # VPC 안 Cloud Map 주소(http://member.ureca.local:8080/…)를 쓰는 동안만 명시
  # public-keys:                # JWKS 대신 정적 공개키(kid → X.509 PEM). 부하 시험 · 로컬용
  #   local-1: |
  #     -----BEGIN PUBLIC KEY-----
  #     ...
  #     -----END PUBLIC KEY-----

# 입장권 · 대기 토큰 서명 키. preorder 의 nova.admission-ticket 과 같은 값이어야 접수가 통과한다.
waitingroom:
  token:
    secret: ${WAITING_TOKEN_SECRET}
    previous: ${WAITING_TOKEN_PREVIOUS:}
    rollout-ends-at: ${WAITING_TOKEN_ROLLOUT_ENDS_AT:}
    # 입장권 수명(입장 시각부터). 기본 120s, 30s ~ 10m. 늘리면 preorder 의 nova.admission-ticket.ttl 도 그 이상으로
    # admission-ttl: 120s
  # 관리자가 올릴 수 있는 입장 속도(초당 입장 인원)의 최댓값. 기본 1500, preorder 대수를 바꾸면 같이 바꾼다
  # admission:
  #   max-global-credit: 1500
  relay:
    # preorder 주소(VPC 안 Cloud Map). 접수 POST 만 이리로 전달한다
    preorder-uri: http://preorder.ureca.local:8083
    # preorder 의 nova.admission-ticket.clock-skew 와 같은 값. 거절 뒤 재진입 대기(Retry-After)가 이 값 + 1초다
    # preorder-clock-skew: 30s
  schedule:
    # 기본값: 일정 이벤트 waitingroom-events, 재발행 요청 preorder-events
    queue: waitingroom-events
    # 일정을 아는 동안에도 전체 재발행을 요청하는 주기. 기본 10m, 0 이면 끈다(1분 미만은 기동 실패)
    # resync:
    #   periodic: 10m

# SQS(회차 일정 수신 · 재발행 요청). 지역이 없으면 일정을 받지 않는다(로컬은 Redis 에 직접 넣는다)
nova:
  sqs:
    region: ap-northeast-2
    # endpoint: http://localhost:4566   # 로컬 Floci 일 때만. 배포 환경은 비워 IAM 역할을 쓴다
  # 브라우저 호출을 허용할 프론트 오리진(scheme://host[:port], 정확 일치). 적으면 기본값(운영 프론트 두 도메인 · API 도메인)이 통째로 바뀐다.
  # 로컬에서만 적는다 — 운영은 기본값을 쓴다.
  cors:
    allowed-origins:
      - http://localhost:5173   # 로컬 프론트(Vite)
