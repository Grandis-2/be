spring:
  application:
    name: catalog
  datasource:
    url: jdbc:mysql://localhost:3306/shop?serverTimezone=UTC&characterEncoding=UTF-8
    username: nova
    password: CHANGE_ME
    hikari:
      # MySQL 서버 기본값은 REPEATABLE READ 다. 반드시 여기서 바꾼다.
      # 근거: "없는 행을 잠금 읽기로 확인한 뒤 INSERT" 하는 절차가 RR 에서
      #      갭 락과 삽입 의도 락으로 교착한다 (실측 RR 4/4 데드락, RC 4/4 통과).
      # 빠뜨려도 오류가 나지 않는다. 부하가 걸릴 때까지 아무도 모른다.
      transaction-isolation: TRANSACTION_READ_COMMITTED
      maximum-pool-size: 10
  jpa:
    # 정본은 flyway-project/migrations. docs/schema.sql은 생성된 최신 구조다.
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        jdbc:
          time_zone: UTC
    open-in-view: false
  data:
    redis:
      host: localhost
      port: 6379
      # 죽는 것보다 느려지는 게 위험하다 — 응답이 5초씩 걸리면 톰캣 스레드가 전부 잠기고
      # Redis 와 무관한 API 까지 멈춘다. 300ms 를 넘겼으면 캐시를 쓸 이유가 없다.
      timeout: 300ms
      connect-timeout: 200ms
      lettuce:
        pool:
          max-active: 16
          max-wait: 100ms

server:
  port: 8082

# 상품 정보는 캐시하고 재고는 캐시하지 않는다 — stale 재고로 초과 판매가 난다.
cache:
  product-ttl: 10m
  price-ttl: 1m

# 검증만 한다. 공개키 하나면 되고 member 를 호출하지 않는다.
jwt:
  public-key: file:${JWT_PUBLIC_KEY_PATH:./keys/jwt-public.pem}
