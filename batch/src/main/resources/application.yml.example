spring:
  application:
    name: batch
  main:
    web-application-type: none
  datasource:
    url: jdbc:mysql://localhost:3306/shop?serverTimezone=UTC&characterEncoding=UTF-8
    username: nova
    password: CHANGE_ME
    hikari:
      # MySQL 서버 기본값은 REPEATABLE READ 다. 반드시 여기서 바꾼다.
      # 근거: "없는 행을 잠금 읽기로 확인한 뒤 INSERT" 하는 절차가 RR 에서
      #      갭 락과 삽입 의도 락으로 교착한다 (실측 RR 4/4 데드락, RC 4/4 통과).
      # 빠뜨려도 오류가 나지 않는다. 부하가 걸릴 때까지 아무도 모른다.
      transaction-isolation: TRANSACTION_READ_COMMITTED
      maximum-pool-size: 10
  jpa:
    # 정본은 flyway-project/migrations. 최신 구조 덤프는 bash flyway-project/verify.sh 의 build/flyway/schema.sql.
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        jdbc:
          time_zone: UTC
    open-in-view: false

# desired 1 고정. 여러 개가 뜨면 같은 스캔이 중복 실행된다.
nova:
  batch:
    expiry-scan-cron: "0 */1 * * * *"
    reconciliation-report-dir: ./build/reports/reconciliation

# 정합성 검사는 Mock API 가 아니라 external_mock DB 를 직접 조회한다.
external-mock:
  datasource:
    url: jdbc:mysql://localhost:3306/external_mock?serverTimezone=UTC
    username: nova
    password: CHANGE_ME
