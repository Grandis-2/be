spring:
  application:
    name: batch
  main:
    web-application-type: none
  datasource:
    # socketTimeout — 드라이버가 DB 응답을 기다리는 상한(밀리초). 검사 제한 시간(run-timeout)은 DB 에 조회 취소를 보내는 방식이라
    # 네트워크가 응답 없이 끊기면 닿지 않는다. 그때도 무한정 기다리지 않게 run-timeout 과 같은 30분을 둔다
    url: jdbc:mysql://localhost:3306/shop?serverTimezone=UTC&characterEncoding=UTF-8&socketTimeout=1800000
    # batch 전용 계정. 업무 표는 읽기만, 결과 표(reconciliation_runs · reconciliation_findings)에만 쓴다
    username: nova
    password: CHANGE_ME
    hikari:
      # MySQL 서버 기본값은 REPEATABLE READ 다. 반드시 여기서 바꾼다.
      # 근거: "없는 행을 잠금 읽기로 확인한 뒤 INSERT" 하는 절차가 RR 에서
      #      갭 락과 삽입 의도 락으로 교착한다 (실측 RR 4/4 데드락, RC 4/4 통과).
      # 빠뜨려도 오류가 나지 않는다. 부하가 걸릴 때까지 아무도 모른다.
      # 검사 트랜잭션만 코드에서 REPEATABLE READ · 읽기 전용으로 연다(한 스냅샷).
      transaction-isolation: TRANSACTION_READ_COMMITTED
      maximum-pool-size: 10
  jpa:
    # 정본은 flyway-project/migrations. 최신 구조 덤프는 bash flyway-project/verify.sh 의 build/flyway/schema.sql.
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        jdbc:
          time_zone: UTC
    open-in-view: false

# 정합성 검사. desired 1 고정. 아래는 코드 기본값이라 바꿀 때만 적는다(정합성-검사-구현-조치 6장, 10-12 결정)
# nova:
#   batch:
#     reconciliation:
#       cron: "0 0 4 * * *"            # 정기 실행
#       zone: Asia/Seoul
#       request-poll-interval: 5s      # 관리자 실행 요청을 가져가는 주기
#       campaign-close-check-interval: 5m
#       hold-margin: 2m                # 판정 보류 여유. Mock 확정 · 취소가 시작 − 이 값 뒤인 키(검사 도중 바뀐 행)는 판정하지 않는다. Mock · batch 시계 차이 여유
#       stuck-after: 45m               # 멈춤 기준. 처리 중(등록 · 취소 · 이벤트 전달 · 결제 확인)이 이만큼 안 끝나면 문제(worker 재시도 최대 약 41분). 회차 마감 뒤 실행도 마감 + 이 값에 돈다
#       intake-rush-window: 1h         # 회차 오픈 뒤 이 구간에는 정기 · 마감 뒤 실행을 건너뛴다
#       run-timeout: 30m               # 검사 트랜잭션 제한 시간. 넘으면 조회를 끊고 판정 불가. external.mock.max-duration 보다 길게
# 안 쓰는 사진 정리 — 기준 시간이 지난 UNUSED 사진(images)의 행과 S3 객체를 지운다. 이것도 코드 기본값이라 바꿀 때만 적는다.
# 기본은 dry-run(대상을 세어 로그만 남김)이다. catalog 가 드로우 생성 시간 예산을 확인했다고 알리면 운영 설정에서 끈다
#     image-cleanup:
#       cron: "0 0 5 * * *"            # 정기 실행. 04:00 정합성 검사 뒤
#       zone: Asia/Seoul
#       retention: 24h                 # 기준 시간. UNUSED 가 된 뒤 이만큼 지난 사진만 지운다. 1h 보다 짧으면 batch 가 뜨지 않는다
#       chunk-size: 500
#       dry-run: true                  # 끄면 실제로 지운다. 끌 때는 아래 업로드 버킷이 있어야 한다(없으면 batch 가 뜨지 않는다)
#   # 지울 사진이 있는 업로드 버킷 — catalog 가 올리는 버킷이라 설정 이름도 같다. 배포 환경은 인프라가 넣고, 자격 증명은 태스크 역할
#   # (업로드 버킷 DeleteObject 권한)을 쓴다. 로컬 에뮬레이터(Floci)에서 지워 볼 때만 연다
#   upload:
#     bucket: CHANGE_ME
#     region: ap-northeast-2
#     endpoint: http://localhost:4566

# Mock 원장은 목록 조회 API(GET /external/reservations)로 읽는다. external_mock DB 는 읽지 않는다.
external:
  mock:
    base-url: http://localhost:8081
    connect-timeout: 2s
    read-timeout: 10s
    page-size: 1000
    # retries: 2                     # 한 페이지를 일시 실패(응답을 받지 못함 · 5xx) 뒤 다시 받는 횟수. 4xx · 계약 위반은 다시 받지 않는다
    # retry-delay: 1s                # 처음 다시 받기 전 기다림. 다음부터 두 배. 기다리는 시간도 목록 전체 기한(max-duration, 10m) 안에 든다
