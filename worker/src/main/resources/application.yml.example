spring:
  application:
    name: worker
  main:
    web-application-type: none
  datasource:
    url: jdbc:mysql://localhost:3306/shop?serverTimezone=UTC&characterEncoding=UTF-8
    username: nova
    password: CHANGE_ME
    hikari:
      # MySQL 서버 기본값은 REPEATABLE READ 다. 반드시 여기서 바꾼다.
      # 근거: "없는 행을 잠금 읽기로 확인한 뒤 INSERT" 하는 절차가 RR 에서
      #      갭 락과 삽입 의도 락으로 교착한다 (실측 RR 4/4 데드락, RC 4/4 통과).
      # 빠뜨려도 오류가 나지 않는다. 부하가 걸릴 때까지 아무도 모른다.
      transaction-isolation: TRANSACTION_READ_COMMITTED
      maximum-pool-size: 10
  jpa:
    # 정본은 flyway-project/migrations. 최신 구조 덤프는 bash flyway-project/verify.sh 의 build/flyway/schema.sql.
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        jdbc:
          time_zone: UTC
    open-in-view: false

spring.cloud.aws:
  region:
    static: ap-northeast-2
  credentials:
    access-key: test
    secret-key: test
  sqs:
    endpoint: http://localhost:4566
    listener:
      # 여러 태스크가 동시에 뜬다. 같은 메시지를 두 번 받는 것은 정상 동작이므로
      # 소비자는 eventId 로 멱등해야 한다.
      max-concurrent-messages: 10
      max-messages-per-poll: 10

nova:
  sqs:
    preorder-queue: nova-preorder
    notification-queue: nova-notification

external:
  mock:
    base-url: http://localhost:8081
    connect-timeout: 2s
    read-timeout: 5s
