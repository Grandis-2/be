# worker 설정 예시. 여기 없는 값은 코드 기본값(WorkerDefaults · WorkerProperties)을 쓴다.
# 웹 서버는 health · 지표용으로만 뜬다(포트 9087). spring.main.web-application-type 을 none 으로 두면 기동하지 않는다.
nova:
  sqs:
    region: ap-northeast-2
    # 로컬 에뮬레이터(Floci). 배포 환경은 비운다(IAM 역할)
    endpoint: http://localhost:4566
  worker:
    mock:
      base-url: http://localhost:8081
    concurrency:
      # worker 하나의 동시 요청 상한 = per-mock(16) × mock-max-instances. 인프라가 mock 자동 확장 최대 대수를 넘긴다
      mock-max-instances: 1
