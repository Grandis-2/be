spring:
  application:
    name: member
  datasource:
    url: jdbc:mysql://localhost:3306/shop?serverTimezone=UTC&characterEncoding=UTF-8
    username: nova
    password: CHANGE_ME
    hikari:
      # MySQL 서버 기본값은 REPEATABLE READ 다. 반드시 여기서 바꾼다.
      # 근거: "없는 행을 잠금 읽기로 확인한 뒤 INSERT" 하는 절차가 RR 에서
      #      갭 락과 삽입 의도 락으로 교착한다 (실측 RR 4/4 데드락, RC 4/4 통과).
      # 빠뜨려도 오류가 나지 않는다. 부하가 걸릴 때까지 아무도 모른다.
      transaction-isolation: TRANSACTION_READ_COMMITTED
      maximum-pool-size: 10
  jpa:
    # 정본은 flyway-project/migrations. 최신 구조 덤프는 bash flyway-project/verify.sh 의 build/flyway/schema.sql.
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        jdbc:
          time_zone: UTC
    open-in-view: false
  # 관리자 알림 대상 이름 — catalog 상품 상세 · order 회차 상세(공개 조회, 토큰 없음). 시간 제한은 코드 기본값(연결 300ms · 읽기 1s, MemberDefaults).
  # 주소가 없거나 답이 없으면 이름만 비우고 알림은 저장한다. 배포 환경의 주소는 인프라 calls 가 넣는다
  http:
    serviceclient:
      catalog:
        base-url: http://localhost:8082
      order:
        base-url: http://localhost:8084
  data:
    redis:
      host: localhost
      port: 6379
      # 죽는 것보다 느려지는 게 위험하다 — 응답이 5초씩 걸리면 톰캣 스레드가 전부 잠기고
      # Redis 와 무관한 API 까지 멈춘다. 300ms 를 넘겼으면 캐시를 쓸 이유가 없다.
      timeout: 300ms
      connect-timeout: 200ms
      lettuce:
        pool:
          max-active: 16
          max-wait: 100ms
server:
  port: 8080
  # 켜지 않는다 — 관리자 로그인 시도 제한이 X-Forwarded-For 를 받은 그대로 센다(auth.admin-login-limit.trusted-proxy-hops).
  # 비워 두면 Spring Boot 가 AWS ECS 를 감지해 스스로 켜고(RemoteIpValve), 헤더를 고쳐 써서 IP 판정이 틀어진다. 켜진 채로 hops > 0 이면 기동 실패
  forward-headers-strategy: none

# 헬스 체크(ALB 대상 그룹): 관리 포트 9080 의 GET /actuator/health/readiness — 토큰 없이 200 {"status":"UP"}. 서비스 포트(8080)로는 actuator 가 나가지 않는다.
# 관리 포트 · 노출(health 만) · probes · readiness 구성(앱 준비 상태만, DB · Redis 제외)은 MemberDefaults 가 코드 기본값으로 준다.
# 여기 management.* 를 적으면 그 값이 이긴다 — 포트를 바꾸면 대상 그룹의 헬스 체크 포트도 같이 바꾼다.

# OpenAPI 문서. 기본은 꺼져 있고 값이 정확히 true 일 때만 켜진다(빈 값 · no · 오타는 꺼짐). 운영에는 적지 않는다.
# api-docs 가 주 스위치다 — UI 만 꺼도 스펙은 열린다.
# member 는 문서 허브다 — hub-services 를 주면 Swagger UI 드롭다운에 서비스별 문서(/v3/api-docs/{서비스})가 나온다.
# 첫 화면은 목록의 첫 서비스. 모든 서비스 문서는 한 출처 뒤(dev: ALB, 로컬: docker/openapi-hub)에서만 열린다.
# springdoc:
#   api-docs:
#     enabled: true
#   swagger-ui:
#     enabled: true
# nova:
#   openapi:
#     hub-services: member,catalog,preorder,order

# 프론트 주도 코드 교환: 프론트가 카카오에서 받은 code 를 POST /api/v1/auth/kakao/callback 으로 보내면 우리가 카카오에 code 를 낸다.
# spring.security.oauth2.client 는 쓰지 않는다. client-secret 은 서버에만 있다(Secrets Manager 주입).
# allowed-redirect-uris: 프론트가 보낸 redirectUri 가 이 목록에 정확히 있어야 한다. 아무 값이나 받으면 code 가 다른 사이트로 샌다.
kakao:
  client-id: CHANGE_ME
  client-secret: CHANGE_ME
  token-uri: https://kauth.kakao.com/oauth/token
  user-info-uri: https://kapi.kakao.com/v2/user/me
  allowed-redirect-uris:
    - http://localhost:3000/login/kakao/callback
  connect-timeout: 2s
  read-timeout: 5s

# 관리자는 회원 밖 단일 계정. password-hash 는 bcrypt 만 받는다(평문이면 기동 실패).
#   htpasswd -nBC 12 "" | tr -d ':\n'
admin:
  username: admin
  password-hash: CHANGE_ME_TO_BCRYPT_HASH
  # 자격증명을 바꾼 뒤에는 배포 완료 후 관리자 토큰으로 DELETE /api/v1/admin/sessions 를 한 번 부른다 — 이전 관리자 세션 전부 폐기(D-16)

# 만료된 회원 리프레시 행 정리. 회전마다 행이 하나 늘어 지우지 않으면 표가 끝없이 커진다.
# 만료 행만 묶음씩 지운다(인스턴스가 여럿이어도 된다). cron 을 "-" 로 두면 끈다.
member:
  refresh-cleanup:
    cron: "0 */10 * * * *"
    batch-size: 1000
    max-batches-per-run: 100
  # 알림 배지 실시간 연결(GET /api/v1/notifications/stream, SSE). 아래가 코드 기본값이라 운영에는 적지 않는다.
  # heartbeat 는 CloudFront 원본 읽기 제한(60초) · ALB 유휴 제한(65초)보다 짧게 — 길면 조용한 연결이 중간에서 끊긴다.
  # max-lifetime 보다 액세스 토큰 만료가 이르면 그때 닫는다 — 화면은 새 토큰으로 다시 연결한다.
  # max-per-customer 를 넘으면 그 회원의 가장 오래된 연결을 닫고, max-connections(인스턴스당)를 넘으면 503 — 화면은 주기 조회로 돌아간다.
  #   max-connections 는 Tomcat 의 server.tomcat.max-connections(기본 8192)보다 넉넉히 작게 — 스트림이 소켓을 다 쓰면 다른 API 가 접속하지 못한다.
  # 연결이 있는 인스턴스만 tail-interval 마다 새 알림을 찾고, 새 연결의 첫 수와 함께 묶어 센다 — 연결은 DB 를 읽지 않아 배포 뒤 몰린 재연결이 풀을
  # 붙잡지 않는다. overlap 은 늦게 커밋된 행을 잡으려고 되돌아 읽는 폭 — 알림 INSERT 하나가 이보다 오래 걸리면 그 알림은 실시간으로 가지 않는다.
  notification:
    stream:
      heartbeat: 25s
      max-lifetime: 30m
      max-per-customer: 5
      max-connections: 5000
      tail-interval: 2s
      overlap: 10s
  # 관리자 알림(contracts/admin-alert-hub.md). 아래가 코드 기본값이라 운영에는 적지 않는다. 소비기는 nova.sqs.consumer.enabled 로 함께 켜진다.
  admin-alert:
    consumer:
      event-queue: admin-alert             # preorder · order 의 ADMIN_ALERT_REQUESTED
      grafana-queue: admin-alert-grafana   # Grafana → SNS(원문 전달) → SQS
      concurrency: 1
      wait-seconds: 20
      # 받은 묶음을 차례로 처리하므로 가시성은 한 묶음의 처리 시간보다 길어야 한다. DB 가 끊기면 건마다 Hikari 연결 대기(30초)가 걸려
      # 5건 × 30초 = 2분 30초다 — 그래서 5건 · 3분(운영 notification 과 같은 값)
      max-messages: 5
      visibility: 3m
      backoff-base: 30s
      backoff-max: 5m
    # 실시간 연결(GET /api/v1/admin/notifications/stream). 뜻은 위 notification.stream 과 같다. max-per-principal 은 한 관리자 계정(토큰 sub)이
    # 이 인스턴스에 여는 연결 수 — 넘으면 가장 오래된 연결을 닫는다. max-pending 은 연결 하나가 쓰지 못하고 쌓아 둘 사건 수 — 넘으면 닫고 화면은 다시
    # 연결해 목록을 새로 읽는다
    stream:
      heartbeat: 25s
      max-lifetime: 30m
      max-per-principal: 20
      max-connections: 100
      max-pending: 1000
      tail-interval: 2s
      overlap: 10s
    # 해소 뒤 30일 지난 알림을 지우고, 받을 때 이름을 받지 못한 상품 · 회차 알림(하루 안)의 이름을 다시 묻는다. cron 을 "-" 로 두면 끈다
    cleanup:
      cron: "0 */10 * * * *"
      retention: 30d
      batch-size: 500
      max-batches-per-run: 20
      refill-window: 1d
      refill-limit: 20

auth:
  # 관리자 로그인 시도 제한(IP 별). 창 안에서 max-attempts 를 넘으면 bcrypt 비교 없이 429 + Retry-After. 성공하면 그 IP 의 수를 지운다.
  # trusted-proxy-hops: X-Forwarded-For 에서 믿는 프록시 수. 운영은 CloudFront → ALB 라 2 — 오른쪽에서 두 번째 칸(CloudFront 가 붙인 실제 IP)을 쓴다.
  #   실제보다 크게 잡으면 클라이언트가 위조한 칸을 읽어 제한이 무력해지고, 작게 잡으면 CloudFront 엣지 IP 로 세어 여러 사용자가 한 수를 나눠 쓴다.
  #   프록시 없이 직접 받는 로컬은 0 도 된다.
  # 셀 수 없으면(Redis 장애) 503 retryable 로 거절한다 — Redis 가 죽으면 관리자 토큰 발급도 어차피 실패한다.
  # max-total-attempts: 모든 IP 를 합친 시도 수(IP 별 제한을 통과한 것만). IP 를 바꿔 가며 오는 공격에도 bcrypt 부하에 천장을 둔다. 성공하면 0.
  admin-login-limit:
    max-attempts: 5
    max-total-attempts: 60
    window: 1m
    trusted-proxy-hops: 2
  # 리프레시 쿠키. 로컬 http 에서는 false 로.
  cookie:
    secure: true
  # 재발급(POST /session/refresh)은 쿠키만으로 도는 유일한 상태 변경 경로라 브라우저의 Origin 헤더를 이 목록과 대조한다(정확 일치).
  # 프론트 오리진(scheme://host[:port]). 없거나 목록 밖이면 403.
  refresh:
    allowed-origins:
      - http://localhost:3000
  # 폐기 표식 조회가 실패했을 때 401 로 닫는 경로. 목록 밖은 열린다(통과 + 경고 + 카운터).
  # 적지 않으면 코드 기본값(MemberDefaults — 아래 넷)이 쓰인다. 공통 기본값 셋(인증이 소유하는 경로)에 관리자 토큰만 받는 내부 경로
  # /internal/customers/names 를 더한 것이다 — 내부 주소로 바로 오는 요청은 부르는 쪽(order · preorder)의 검사를 거치지 않는다.
  # 사전예약 취소 · 주문 취소 · 결제 · 배송지 변경 같은 도메인 경로는 그 경로를 서비스하는 모듈(preorder · order)이 자기 설정에 적는다.
  # 항목 앞에 HTTP 메서드를 붙이면 그 메서드만 닫는다(없으면 전부). 모양이 틀린 항목(모르는 메서드 · 소문자 · '/' 로 시작 안 함)은 기동 실패다.
  revocation-check:
    fail-closed-paths:
      - /api/v1/admin/**
      - /api/v1/session/refresh
      - /api/v1/me/**
      - /internal/customers/names

nova:
  # 브라우저 호출을 허용할 오리진(scheme://host[:port], 정확 일치). 적으면 기본값(운영 프론트 두 도메인 · API 도메인)이 통째로 바뀐다.
  # 프론트 오리진은 따로 적지 않는다 — 위 auth.refresh.allowed-origins 가 CORS 허용에도 더해진다(두 목록이 어긋나지 않게).
  cors:
    allowed-origins:
      - http://localhost:9000   # 로컬 문서 허브(docker/openapi-hub)
  # SQS(AWS SDK v2). 로컬은 Floci(docker/floci). 배포 환경은 endpoint 를 지우고 IAM 역할을 쓴다
  sqs:
    region: ap-northeast-2
    endpoint: http://localhost:4566
    api-call-timeout: 3s
    # 알림 요청(preorder · order → member) 소비기. 끄면 알림이 큐에 쌓이기만 한다 — 운영에서 끄지 않는다.
    # Floci 없이 띄우면 받기 실패 경고만 남는다(최대 30초 간격). 로그인만 볼 때는 false 로
    consumer:
      enabled: true
      queue: notification
      concurrency: 1
      wait-seconds: 20
      visibility: 5m       # 처리 한 건보다 길게
      backoff-base: 30s    # DB 순단에 DLQ 가 차지 않게 — 5번 실패해 DLQ 까지 약 6~12분(5s 면 1~3분)
      backoff-max: 5m

# 서명은 RS256. member 만 개인키를 갖고 서명한다. 다른 서비스는 jwk-set-uri 로 공개키를 받아 검증만 한다.
#   개인키 생성: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem   (PKCS#8, "BEGIN PRIVATE KEY")
#   운영은 Secrets Manager 에 두고 ECS secrets 로 주입. CHANGE_ME 면 기동이 실패한다.
# 키 교체 순서: ① 새 키쌍 생성 ② 검증 서비스가 새 공개키를 받을 시간을 둔다(주기 갱신 5분 — public-keys 로 미리 넣거나 JWKS 게시 뒤 5분 이상 대기) ③ member 의 private-key·key-id 를 새 키로, public-keys 를 **옛** 공개키로 바꿔 배포(새 공개키를 남겨 두면 옛 kid 가 사라져 살아 있는 리프레시가 전부 죽는다) ④ 리프레시 만료(14일) 뒤 public-keys 에서 옛 키 제거
jwt:
  issuer: nova
  audience: nova-api            # RFC 8725 §3.9. 검증하는 서비스 넷이 같은 값. 비우면 nova-api
  key-id: 2026-09-k1            # 토큰 헤더 kid. 키를 바꿀 때마다 새 이름
  private-key: CHANGE_ME
  # public-keys:                # 교체 중인 이전 공개키(kid → X.509 PEM). 검증 서비스에서는 jwk-set-uri 대신 쓸 수도 있다
  #   2026-06-k0: |
  #     -----BEGIN PUBLIC KEY-----
  #     ...
  #     -----END PUBLIC KEY-----
  # jwk-set-uri: https://…/.well-known/jwks.json   # 검증 서비스(catalog·preorder·order)만. member 는 비운다. https 가 아니면 기동 실패. 5분마다 백그라운드로 다시 받고, 모르는 kid 는 그 요청을 401 로 보낸 뒤 비동기로 다시 받는다(요청 스레드는 기다리지 않는다)
  # jwk-set-allow-http: true                         # VPC 안 Cloud Map 주소(http://member.ureca.local:8080/…)를 쓰는 동안만 명시. TLS 가 붙으면 지운다
  access-token-validity: 30m    # 폐기 표식을 못 읽는 동안(fail-open) 로그아웃·제재된 토큰이 살아남는 상한. 재발급은 쿠키로 자동이라 30분이면 사용자는 못 느낀다
  refresh-token-validity: 14d   # 0 이나 음수, 액세스보다 짧으면 기동 실패
