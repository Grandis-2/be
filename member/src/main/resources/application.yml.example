spring:
  application:
    name: member
  datasource:
    url: jdbc:mysql://localhost:3306/shop?serverTimezone=UTC&characterEncoding=UTF-8
    username: nova
    password: CHANGE_ME
    hikari:
      # MySQL 서버 기본값은 REPEATABLE READ 다. 반드시 여기서 바꾼다.
      # 근거: "없는 행을 잠금 읽기로 확인한 뒤 INSERT" 하는 절차가 RR 에서
      #      갭 락과 삽입 의도 락으로 교착한다 (실측 RR 4/4 데드락, RC 4/4 통과).
      # 빠뜨려도 오류가 나지 않는다. 부하가 걸릴 때까지 아무도 모른다.
      transaction-isolation: TRANSACTION_READ_COMMITTED
      maximum-pool-size: 10
  jpa:
    # 정본은 flyway-project/migrations. docs/schema.sql은 생성된 최신 구조다.
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        jdbc:
          time_zone: UTC
    open-in-view: false
  data:
    redis:
      host: localhost
      port: 6379
      # 죽는 것보다 느려지는 게 위험하다 — 응답이 5초씩 걸리면 톰캣 스레드가 전부 잠기고
      # Redis 와 무관한 API 까지 멈춘다. 300ms 를 넘겼으면 캐시를 쓸 이유가 없다.
      timeout: 300ms
      connect-timeout: 200ms
      lettuce:
        pool:
          max-active: 16
          max-wait: 100ms
  security:
    oauth2:
      client:
        registration:
          kakao:
            client-id: CHANGE_ME
            client-secret: CHANGE_ME
            redirect-uri: http://localhost:8080/login/oauth2/code/kakao
            authorization-grant-type: authorization_code
            client-authentication-method: client_secret_post
            scope: profile_nickname
        provider:
          kakao:
            authorization-uri: https://kauth.kakao.com/oauth/authorize
            token-uri: https://kauth.kakao.com/oauth/token
            user-info-uri: https://kapi.kakao.com/v2/user/me
            user-name-attribute: id

server:
  port: 8080

# RS256. member 만 개인키를 갖는다 — 발급자가 하나여야 하기 때문이다.
# 나머지 서비스와 대기열은 공개키만 받으므로, 공개키가 유출돼도 토큰을 위조할 수 없다.
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt-private.pem
#   openssl rsa -pubout -in keys/jwt-private.pem -out keys/jwt-public.pem
#
# keys/ 는 .gitignore 에 있다. 개인키를 커밋하지 않는다.
jwt:
  private-key: file:${JWT_PRIVATE_KEY_PATH:./keys/jwt-private.pem}
  public-key:  file:${JWT_PUBLIC_KEY_PATH:./keys/jwt-public.pem}
  # 짧게 둔다. 로그아웃 즉시 무효화(블랙리스트)를 쓰지 않는 대신,
  # 리프레시 토큰을 Redis 에서 지우면 이 시간 뒤 완전히 끊긴다.
  access-token-validity: 30m
  refresh-token-validity: 14d
